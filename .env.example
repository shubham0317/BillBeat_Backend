# BillBeat Backend Environment Configuration Example
# Copy this file to .env or pass as system environment variables

# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/billbeat_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# Security
JWT_SECRET=your_super_secret_jwt_key_that_is_at_least_256_bits_long_change_in_production

# WhatsApp Provider Configuration
# Supported values: MOCK, META_CLOUD_API
WHATSAPP_PROVIDER=MOCK
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_cloud_api_bearer_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_VERIFY_TOKEN=billbeat_webhook_verify_token
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v19.0

# Billing Strategy
# Supported values: SCHEDULED_DAYS, ACTUAL_DELIVERIES
BILLING_STRATEGY=SCHEDULED_DAYS

# Schedulers
MONTHLY_BILLING_CRON=0 0 2 1 * ?
